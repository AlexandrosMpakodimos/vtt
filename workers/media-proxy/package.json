{
  "name": "vtt-media-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that proxies media requests to the VTT application's media route. Separate from the application package. Not deployed.",
  "type": "module",
  "scripts": {
    "test:unit": "node --test test/handler.test.mjs",
    "test:runtime": "node --test test/runtime.test.mjs",
    "test": "node --test test/handler.test.mjs test/runtime.test.mjs",
    "test:integration": "node --test --test-timeout=60000 --test-force-exit test/integration/worker-to-router.test.mjs"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.0"
    }
  }
}
