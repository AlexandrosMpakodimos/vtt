PORT=3000
DATABASE_URL=postgresql://vtt:vtt-local@localhost:5432/vtt
SESSION_SECRET=change-this-to-a-random-string
NODE_ENV=development

# Local development: print email links (verification, password reset) in the
# terminal instead of sending email. Never set in production.
MAIL_JSON=1

# Only needed if you change PORT: the public address of the app, used in email
# links and the origin check. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Image uploads need a Cloudflare R2 bucket (R2_ACCOUNT_ID, R2_BUCKET,
# R2_PUBLIC_BASE_URL, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) and MEDIA_HOST.
# Leave them unset locally: images can still be added by URL. See
# docs/deployment.md.

# Optional; leave blank. Only for a media proxy Worker in front of /media (see
# docs/deployment.md). If set: at least 32 characters, different from
# SESSION_SECRET and MEDIA_TOKEN_SECRET. Do not put a real value in this file.
MEDIA_PROXY_SECRET=

# Narrow production DB profile (only when NODE_ENV=production):
# DATABASE_URL=postgresql://USER:PERCENT_ENCODED_PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full
# DIRECT_DATABASE_URL=postgresql://USER:PERCENT_ENCODED_PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/DATABASE?sslmode=verify-full
# DIRECT_DATABASE_URL belongs in the operator migration environment, not the web service.
# Only optional sslmode=require|verify-full is accepted. Other URL options,
# including channel_binding, are rejected. Both accepted modes verify TLS/hostname.
# No PG* overrides; see docs/deployment.md for the exact production profile.
# Role/database search_path must be exactly public for both application and migration roles.

# Required in production. Dedicated same-region Render Key Value internal URL.
# Do not put a real connection URL in this tracked example.
COORDINATION_URL=
# All instances of this app must share the same prefix.
COORDINATION_PREFIX=vtt:coord:v1

# Required explicitly in production. Use 1 only after verifying every ingress
# path passes through one trusted reverse proxy that sanitizes forwarding headers.
# Direct local development ignores forwarding headers by default (0).
# TRUST_PROXY_HOPS=1
# HTTP rate limits share COORDINATION_URL/COORDINATION_PREFIX and SESSION_SECRET.
# All replicas must use identical limiter settings, prefix and session secret.
